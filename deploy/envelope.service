[Unit]
Description=Envelope budgeting app
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=envelope
WorkingDirectory=/opt/envelope
ExecStart=/usr/bin/node server/index.js
Restart=always
RestartSec=5

# Only cloudflared, on this same machine, should be able to reach the app.
Environment=HOST=127.0.0.1
Environment=PORT=4517
Environment=NODE_ENV=production

# The app needs nothing outside its own directory.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/envelope/data /opt/envelope/backups
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true

StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
